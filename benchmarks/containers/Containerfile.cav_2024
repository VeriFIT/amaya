# Image of Amaya at the git tag `cav_2024` (a94f57b, 2024-02-08).
#
# The tag predates the repository's Dockerfile and the in-tree mtbdd-backend/.
# At that revision, amaya/mtbdd_transitions.py loads `amaya/amaya-mtbdd.so` via
# ctypes; the library is built from https://github.com/MichalHe/amaya-mtbdd at
# its tag `cav_2024` (d4e45bb), following the build steps of the first
# Dockerfile in this repository (commit 514e9e5).
#
# Build context: `git archive cav_2024` of this repository
# (see benchmarks/containers/build-images.sh).
FROM docker.io/library/debian:bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates gcc g++ cmake make git python3 python3-pip \
        libgmp-dev libhwloc-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/trolando/sylvan.git /sylvan
WORKDIR /sylvan
RUN git checkout v1.5.0 && sed -i 's/-Werror//g' CMakeLists.txt
RUN mkdir build && cd build && cmake .. && make -j"$(nproc)" && make install && ldconfig

ARG AMAYA_MTBDD_REVISION=cav_2024
RUN git clone https://github.com/MichalHe/amaya-mtbdd.git /amaya-mtbdd
WORKDIR /amaya-mtbdd
RUN git checkout "${AMAYA_MTBDD_REVISION}" && make -j"$(nproc)" shared-lib

COPY . /amaya
WORKDIR /amaya
RUN cp /amaya-mtbdd/build/amaya-mtbdd.so /amaya/amaya/
RUN pip3 install -r requirements.txt --break-system-packages
# run-amaya.py:display_runtime_statistics imports tabulate on every get-sat
# run; tabulate is missing from requirements.txt at this revision.
RUN pip3 install tabulate --break-system-packages
ENV LD_LIBRARY_PATH="/usr/local/lib"
